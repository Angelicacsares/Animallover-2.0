function cardCliente(id, nome, telefone){

    const iniciais = nome
        .split(" ")
        .map(parte => parte[0])
        .slice(0,2)
        .join("")
        .toUpperCase();

    return `

        <div
            class="cliente"
            onclick="abrirFichaCliente(${id})"
        >

