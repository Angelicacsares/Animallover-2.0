// ======================================================
// BOTTOM SHEET
// ======================================================

function abrirBottomSheet(conteudo){

    if(document.getElementById("bottomSheet")){

        document.getElementById("bottomSheet").remove();

    }

    document.body.insertAdjacentHTML(

        "beforeend",

        `

        <div
            class="fundo-bottom-sheet"
            id="bottomSheet"
            onclick="fecharBottomSheet()"
        >

            <div
                class="bottom-sheet"
                onclick="event.stopPropagation()"
            >

                <div
    class="barra-sheet"
    id="barraSheet"
></div>

                ${conteudo}

            </div>

        </div>

        `

    );

const sheet = document.querySelector(".bottom-sheet");
const barra = document.getElementById("barraSheet");

let inicioY = 0;
let altura = 70; // começa ocupando 70% da tela

barra.addEventListener("touchstart", function(e){

    inicioY = e.touches[0].clientY;

});

barra.addEventListener("touchmove", function(e){

    const atual = e.touches[0].clientY;

    const diferenca = inicioY - atual;

    if(Math.abs(diferenca) < 20) return;

    altura += diferenca / 15;

    if(altura < 45) altura = 45;
    if(altura > 95) altura = 95;

    sheet.style.maxHeight = altura + "vh";

    inicioY = atual;

});

}

function fecharBottomSheet(){

    const sheet = document.getElementById("bottomSheet");

    if(sheet){

        sheet.remove();

    }

}