// ======================================================
// CARD DO TUTOR
// ======================================================

function cardTutorPet(tutor){

    const iniciais = tutor.nome
        .split(" ")
        .map(nome => nome[0])
        .slice(0,2)
        .join("")
        .toUpperCase();

    return `

        <div class="cliente">

            <div class="avatar">

                ${iniciais}

            </div>

            <div class="dados-cliente">

                <h3>

                    ${tutor.nome}

                </h3>

                <p>

                    Tutor selecionado

                </p>

            </div>

        </div>

    `;

}



