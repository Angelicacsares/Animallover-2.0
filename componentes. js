function campoBusca(placeholder = "Buscar"){

    return `

        <div class="buscar">

            <span class="material-symbols-rounded lupa">

                search

            </span>

            <input
                type="text"
                placeholder="${placeholder}"
            >

        </div>

    `;

}



// ======================================================
// CAMPO DE TEXTO
// ======================================================

function campoTexto(
    label,
    id,
    placeholder,
    tipo = "text",
    atributos = ""
){

    return `

        <div class="campo">

            <label for="${id}">

                ${label}

            </label>

            <input
                type="${tipo}"
                id="${id}"
                placeholder="${placeholder}"
                ${atributos}
            >

        </div>

    `;

}



// ======================================================
// CAMPO DATA
// ======================================================

function campoData(label, id){

    return `

        <div class="campo">

            <label for="${id}">

                ${label}

            </label>

            <input
                type="date"
                id="${id}"
            >

        </div>

    `;

}



// ======================================================
// CAMPO SELECT
// ======================================================

function campoSelect(label, id, opcoes){

    let html = `

        <div class="campo">

            <label for="${id}">

                ${label}

            </label>

            <select id="${id}">

                <option value="">

                    Selecione...

                </option>

    `;

    opcoes.forEach(opcao => {

        html += `

            <option value="${opcao}">

                ${opcao}

            </option>

        `;

    });

    html += `

            </select>

        </div>

    `;

    return html;

}



